{
  "name": "chat-with-your-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "SERVICE_NAME=worker node --env-file-if-exists=.env --import tsx worker/index.ts",
    "worker:dev": "SERVICE_NAME=worker node --env-file-if-exists=.env --watch --import tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "SERVICE_NAME=migrate node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^4.0.0",
    "next": "16.3.3",
    "openai": "^7.8.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
