DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_with_your_docs
OPENAI_API_KEY=
ANSWER_MODEL=gpt-5.6-terra
REWRITE_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
CHUNK_MIN_TOKENS=80
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=15728640
MAX_QUESTION_CHARACTERS=4000
RETRIEVAL_TOP_K=8
GENERATION_MAX_CHUNKS=6
LOG_LEVEL=info
DB_POOL_MAX=10
